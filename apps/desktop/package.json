{
  "name": "@scenarioforge/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.config.ts --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && electron-vite build",
    "build:web": "tsc -b && vite build --config vite.config.ts",
    "preview": "electron-vite preview",
    "preview:web": "vite preview --config vite.config.ts --host 127.0.0.1"
  },
  "dependencies": {
    "@scenarioforge/contracts": "*",
    "@scenarioforge/pi-runtime": "*",
    "@scenarioforge/project-runtime": "*",
    "@scenarioforge/runtime-state": "*",
    "@scenarioforge/scenario-pipeline": "*",
    "@scenarioforge/test-runtime": "*",
    "pretendard": "^1.3.9",
    "react": "latest",
    "react-dom": "latest",
    "typescript-compiler": "npm:typescript@5.9.3"
  }
}
