{
  "name": "scenarioforge",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first user scenario design and test automation desktop application",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "npm run dev --workspace @scenarioforge/desktop",
    "dev:web": "npm run dev:web --workspace @scenarioforge/desktop",
    "test": "npm run test --workspaces --if-present && vitest run --config vitest.config.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspace @scenarioforge/desktop",
    "build:web": "npm run build:web --workspace @scenarioforge/desktop",
    "capture:readme": "electron scripts/capture-readme.cjs",
    "preview": "npm run preview --workspace @scenarioforge/desktop",
    "preview:web": "npm run preview:web --workspace @scenarioforge/desktop"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "latest",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
