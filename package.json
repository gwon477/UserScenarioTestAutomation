{
  "name": "scenarioforge-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first user scenario design and test automation desktop application",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.config.ts --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && electron-vite build",
    "build:web": "tsc -b && vite build --config vite.config.ts",
    "preview": "electron-vite preview",
    "preview:web": "vite preview --config vite.config.ts --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "latest",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
